#version 450

#ifndef SIZE_X
#define SIZE_X 64
#endif

#ifndef SIZE_Y
#define SIZE_Y 1
#endif

#ifndef SIZE_Z
#define SIZE_Z 1
#endif

#define USL_VULKAN 1
#define GLSL
#define SLC_FLOAT

#include "libSLC/slc_core.inc"
#include "libSLC/standard_buffers.inc"

// Main entry point
void Execute(uint x){
    //return;

	uint func_id = SETTINGS_FUNC();
	switch(func_id){
        default:
            break;
	}
}

layout (local_size_x = SIZE_X, local_size_y = SIZE_Y, local_size_z = SIZE_Z) in;
void main()
{
	uint x = gl_GlobalInvocationID.x;
	Execute(x);
}



